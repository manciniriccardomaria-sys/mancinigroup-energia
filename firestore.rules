rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function accessPath() {
      return /databases/$(database)/documents/appAccess/$(request.auth.uid);
    }

    function hasActiveAccess() {
      return signedIn() && exists(accessPath()) && get(accessPath()).data.active == true;
    }

    function access() {
      return get(accessPath()).data;
    }

    function isPersonalProfile() {
      return hasActiveAccess() && access().role in ['agent', 'frontline'] && access().sourceId is string;
    }

    function hasFullDataAccess() {
      return hasActiveAccess() && access().role in ['admin', 'operativo'];
    }

    function isAdmin() {
      return hasActiveAccess() && access().role == 'admin';
    }

    function ownsSource(sourceId) {
      return isPersonalProfile() && sourceId == access().sourceId;
    }

    function validAccessRole(role) {
      return role in ['admin', 'frontline', 'agent', 'operativo'];
    }

    function sourceMatchesAccessRole(role, sourceId) {
      return (role in ['admin', 'operativo'] && sourceId == null) ||
        (
          role in ['agent', 'frontline'] &&
          sourceId is string &&
          exists(/databases/$(database)/documents/appData/sources/items/$(sourceId)) &&
          get(/databases/$(database)/documents/appData/sources/items/$(sourceId)).data.active == true &&
          (
            (role == 'agent' && get(/databases/$(database)/documents/appData/sources/items/$(sourceId)).data.kind == 'collaboratore') ||
            (role == 'frontline' && get(/databases/$(database)/documents/appData/sources/items/$(sourceId)).data.kind == 'frontline')
          )
        );
    }

    function validAccessProfile() {
      return request.resource.data.keys().hasAll([
          'id', 'email', 'name', 'role', 'sourceId', 'active', 'updatedAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'id', 'email', 'name', 'role', 'sourceId', 'active', 'updatedAt'
        ]) &&
        request.resource.data.id is string &&
        request.resource.data.email is string &&
        request.resource.data.name is string &&
        validAccessRole(request.resource.data.role) &&
        request.resource.data.active is bool &&
        request.resource.data.updatedAt is string &&
        sourceMatchesAccessRole(request.resource.data.role, request.resource.data.sourceId);
    }

    match /appAccess/{uid} {
      allow get: if hasActiveAccess() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && validAccessProfile();
      allow delete: if false;
    }

    match /appData/sources/items/{documentId} {
      allow read: if hasFullDataAccess() || (isPersonalProfile() && documentId == access().sourceId);
      allow write: if hasFullDataAccess();
    }

    match /appData/customers/items/{documentId} {
      allow read: if hasFullDataAccess() || ownsSource(resource.data.sourceId);
      allow write: if hasFullDataAccess();
    }

    match /appData/commissionEntries/items/{documentId} {
      allow read: if hasFullDataAccess() || ownsSource(resource.data.sourceId);
      allow write: if hasFullDataAccess();
    }

    match /appData/commissionPayments/items/{documentId} {
      allow read: if hasFullDataAccess() || ownsSource(resource.data.sourceId);
      allow write: if hasFullDataAccess();
    }

    match /appData/commissionForecasts/items/{documentId} {
      allow read: if hasFullDataAccess() || ownsSource(resource.data.sourceId);
      allow write: if hasFullDataAccess();
    }

    match /appData/loadingRecords/items/{documentId} {
      allow read: if hasFullDataAccess() || ownsSource(resource.data.matchedSourceId);
      allow write: if hasFullDataAccess();
    }

    match /appData/agencyMarginRecords/items/{documentId} {
      allow read, write: if hasFullDataAccess();
    }

    match /appData/marketVariables/items/{documentId} {
      allow read: if hasActiveAccess();
      allow write: if hasFullDataAccess();
    }

    // Separate from quote inputs; only the server using Admin SDK writes here.
    match /marketSnapshots/gme {
      allow get: if hasActiveAccess();
      allow list, write: if false;
    }

    match /appData/energyQuotes/items/{documentId} {
      allow read: if hasFullDataAccess() || (isPersonalProfile() && resource.data.createdBy == access().id);
      allow create: if hasFullDataAccess() || (
        isPersonalProfile() &&
        request.resource.data.createdBy == access().id &&
        request.resource.data.sourceId == access().sourceId
      );
      allow update: if hasFullDataAccess() || (
        isPersonalProfile() &&
        resource.data.createdBy == access().id &&
        request.resource.data.createdBy == access().id &&
        request.resource.data.sourceId == access().sourceId
      );
      allow delete: if hasFullDataAccess() || (
        isPersonalProfile() && resource.data.createdBy == access().id
      );
    }

    match /appData/pendingEnergyQuotes/items/{documentId} {
      allow read: if hasFullDataAccess() || (isPersonalProfile() && resource.data.createdBy == access().id);
      allow create: if hasFullDataAccess() || (
        isPersonalProfile() &&
        request.resource.data.createdBy == access().id &&
        request.resource.data.sourceId == access().sourceId
      );
      allow update: if hasFullDataAccess() || (
        isPersonalProfile() &&
        resource.data.createdBy == access().id &&
        request.resource.data.createdBy == access().id &&
        request.resource.data.sourceId == access().sourceId
      );
      allow delete: if hasFullDataAccess() || (
        isPersonalProfile() && resource.data.createdBy == access().id
      );
    }

    match /appData/managedOffers/items/{documentId} {
      allow read: if hasActiveAccess();
      allow write: if hasFullDataAccess();
    }

    match /appData/customerTickets/items/{documentId} {
      allow read: if hasFullDataAccess() || ownsSource(resource.data.sourceId);
      allow create: if hasFullDataAccess() || (isPersonalProfile() &&
        request.resource.data.sourceId == access().sourceId && request.resource.data.createdBy == access().id);
      allow update: if hasFullDataAccess() || (ownsSource(resource.data.sourceId) &&
        request.resource.data.sourceId == resource.data.sourceId &&
        request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if hasFullDataAccess();
    }

    match /appData/users/items/{documentId} {
      allow read: if hasFullDataAccess();
      allow write: if isAdmin();
    }

    match /appData/commissionRules/items/{documentId} {
      allow read, write: if hasFullDataAccess();
    }

    match /appData/productionMetrics/items/{documentId} {
      allow read, write: if hasFullDataAccess();
    }

    match /appData/uploadedFiles/items/{documentId} {
      allow read, write: if hasFullDataAccess();
    }

    match /quoteBillFiles/{fileId} {
      function ownsBill(data) {
        return isPersonalProfile() && data.ownerId == access().id && data.sourceId == access().sourceId;
      }

      function validBill() {
        return request.resource.data.keys().hasOnly([
          'id', 'originalName', 'mimeType', 'size', 'chunkCount', 'uploadedAt', 'uploadedBy', 'ownerId', 'sourceId', 'ready'
        ]) && request.resource.data.id == fileId &&
          request.resource.data.originalName is string &&
          request.resource.data.mimeType in ['application/pdf', 'image/png', 'image/jpeg', 'image/webp'] &&
          request.resource.data.size is int && request.resource.data.size > 0 && request.resource.data.size <= 10485760 &&
          request.resource.data.chunkCount is int && request.resource.data.chunkCount > 0 && request.resource.data.chunkCount <= 20 &&
          request.resource.data.ownerId is string && request.resource.data.ready is bool;
      }

      allow read, delete: if hasFullDataAccess() || ownsBill(resource.data);
      allow create: if validBill() && request.resource.data.ready == false && (
        hasFullDataAccess() || (ownsBill(request.resource.data) && request.resource.data.uploadedBy == access().id)
      );
      allow update: if validBill() && (hasFullDataAccess() || ownsBill(resource.data)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ready']) && request.resource.data.ready == true;

      match /chunks/{chunkId} {
        function bill() {
          return get(/databases/$(database)/documents/quoteBillFiles/$(fileId)).data;
        }

        allow read, delete: if hasFullDataAccess() || ownsBill(bill());
        allow create: if (hasFullDataAccess() || ownsBill(bill())) && bill().ready == false &&
          request.resource.data.keys().hasOnly(['data']) && request.resource.data.data is string &&
          request.resource.data.data.size() <= 699052 && int(chunkId) >= 0 && int(chunkId) < bill().chunkCount;
        allow update: if false;
      }
    }

    match /appMeta/{documentId} {
      allow read, write: if hasFullDataAccess();
    }
  }
}
